# Provider fallback route. Valid providers: openrouter-free, gemini, openai.
RESUME_TAILOR_ROUTE=openrouter-free,gemini,openai

# Paid fallback behavior: ask, auto, or never.
RESUME_TAILOR_PAID_FALLBACK=ask

# Optional default resume path. CLI --resume overrides this.
RESUME_TAILOR_RESUME=./samples/resume.md

# Optional timeout in seconds.
RESUME_TAILOR_TIMEOUT=240

# Provider keys are optional individually. At least one provider key is required for live tailoring.

# OpenRouter free route. Required only when using openrouter-free.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto-free
OPENROUTER_APP_TITLE=Resume Tailor
# OPENROUTER_REFERER=

# OpenAI API provider. Required only when using openai.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-codex

# Optional routing headers if your OpenAI account uses multiple orgs/projects.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Gemini provider. Required only when using gemini.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
